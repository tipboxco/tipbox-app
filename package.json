{
  "name": "Tipbox",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-collapsible-tab-view",
          "react-native-exception-handler"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev": "copy .env.development .env && expo start",
    "start:test": "copy .env.test .env && expo start",
    "start:prod": "copy .env.production .env && expo start",
    "android": "expo run:android",
    "android:test": "copy .env.test .env && set DARK_MODE=media && expo start --android",
    "android:prod": "copy .env.production .env && set DARK_MODE=media && expo start --android",
    "ios": "expo run:ios",
    "ios:test": "copy .env.test .env && set DARK_MODE=media && expo start --ios",
    "ios:prod": "copy .env.production .env && set DARK_MODE=media && expo start --ios",
    "web": "copy .env.development .env && set DARK_MODE=media && expo start --web",
    "web:test": "copy .env.test .env && set DARK_MODE=media && expo start --web",
    "web:prod": "copy .env.production .env && set DARK_MODE=media && expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/button": "^1.0.14",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/icon": "^0.1.27",
    "@gluestack-ui/nativewind-utils": "^1.0.10",
    "@gluestack-ui/overlay": "^0.1.22",
    "@gluestack-ui/themed": "^1.1.73",
    "@gluestack-ui/toast": "^1.0.9",
    "@gorhom/bottom-sheet": "^5.2.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/drawer": "^7.5.3",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@react-navigation/stack": "^7.4.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.10",
    "@types/react-native": "^0.73.0",
    "axios": "^1.10.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "base-64": "^1.0.0",
    "date-fns": "^4.1.0",
    "expo": "^54.0.30",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "^8.0.11",
    "expo-localization": "~17.0.8",
    "expo-navigation-bar": "^5.0.10",
    "expo-notifications": "~0.32.15",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.15",
    "firebase": "^12.7.0",
    "lucide-react-native": "^0.525.0",
    "nativewind": "^4.1.23",
    "promise": "^8.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.68.0",
    "react-native": "0.81.5",
    "react-native-animated-stopwatch-timer": "^1.3.0",
    "react-native-circular-progress": "^1.4.1",
    "react-native-collapsible-tab-view": "^8.0.1",
    "react-native-css-interop": "^0.1.22",
    "react-native-dotenv": "^3.4.11",
    "react-native-exception-handler": "^2.10.10",
    "react-native-fetch-api": "^3.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
