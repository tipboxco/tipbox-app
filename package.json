    "yup": "^1.7.1",
    "zeego": "^3.0.6",
    "zod": "^4.1.13",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^25.0.3",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
