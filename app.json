{
  "expo": {
    "name": "Tipbox",
    "slug": "tipbox-app",
    "version": "1.0.0",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/e740cd51-8289-4b1d-af1d-a7159ea5bbc2"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/tipbox_logo.png",
    "splash": {
      "backgroundColor": "#000000"
    },
    "scheme": "tipboxapp",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tipbox.ios",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotoğraf çekmek için kameraya ihtiyaç var.",
        "NSMicrophoneUsageDescription": "Video kaydı için mikrofona ihtiyaç var.",
        "NSPhotoLibraryUsageDescription": "Badge'leri galerinize kaydetmek için izin gereklidir.",
        "NSPhotoLibraryAddUsageDescription": "Badge'leri galerinize kaydetmek için izin gereklidir.",
        "NSUserNotificationsUsageDescription": "Bildirimleri almak için izin gereklidir.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "tipboxapp",
              "com.googleusercontent.apps.886406936506-j4u0lsdg6gnn7ggv5mda80rothf5tqr4"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tipbox.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tipbox-square-black.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fotoğraf çekmek için kameraya ihtiyaç var.",
          "microphonePermission": "Video için mikrofona ihtiyaç var."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "extraPods": []
          }
        }
      ],
      "expo-video",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "e740cd51-8289-4b1d-af1d-a7159ea5bbc2"
      },
      "sentryDsn": "https://d9859d5405c7ed247b84d8112291a107@o4510999354605568.ingest.us.sentry.io/4510999365091328"
    },
    "owner": "tipboxco"
  }
}
