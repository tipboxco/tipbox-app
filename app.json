{
  "expo": {
    "name": "",
    "slug": "tipbox-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/098fbee5-88e4-49ba-bb37-80601a5d47af"
    },
    "orientation": "portrait",
    "icon": "./assets/tipbox-square-black.png",
    "splash": {
      "image": "./assets/splash-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "scheme": "tipboxapp",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devkocmehmet.tipboxapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotoğraf çekmek için kameraya ihtiyaç var.",
        "NSMicrophoneUsageDescription": "Video kaydı için mikrofona ihtiyaç var.",
        "NSUserNotificationsUsageDescription": "Bildirimleri almak için izin gereklidir.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "188.245.150.117": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSExceptionMinimumTLSVersion": "TLSv1.0"
            },
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.devkocmehmet.tipboxapp",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tipbox-square-black.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-black.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/tipbox-white-logo.jpg",
          "color": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fotoğraf çekmek için kameraya ihtiyaç var.",
          "microphonePermission": "Video için mikrofona ihtiyaç var."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "098fbee5-88e4-49ba-bb37-80601a5d47af"
      }
    }
  }
}

