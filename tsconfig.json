{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./*"],
      "tailwind.config": ["./tailwind.config.js"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/node_modules/**/tsconfig.json"
  ]
}
